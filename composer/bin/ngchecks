#!/bin/sh
# Runs the ngchecks binary installed by the netgen/ngchecks Composer plugin into var/<platform>/.
set -eu

case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) os=$(uname -s) ;;
esac

case "$(uname -m)" in
    x86_64 | amd64) arch=x64 ;;
    arm64 | aarch64) arch=arm64 ;;
    *) arch=$(uname -m) ;;
esac

package_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
binary="$package_dir/var/${os}_${arch}/ngchecks"

if [ ! -x "$binary" ]; then
    echo "ngchecks: no binary for ${os}_${arch} in $package_dir/var." >&2
    echo "Run \"composer install\" on this machine. If the netgen/ngchecks plugin is not allowed yet, run first:" >&2
    echo "    composer config allow-plugins.netgen/ngchecks true" >&2
    exit 2
fi

exec "$binary" "$@"
