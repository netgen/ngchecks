{
    "name": "netgen/ngchecks",
    "description": "Project checks for git hooks and CI: secret leak protection powered by Betterleaks",
    "type": "composer-plugin",
    "license": "MIT",
    "keywords": [
        "secrets",
        "security",
        "betterleaks",
        "gitleaks",
        "captainhook"
    ],
    "homepage": "https://github.com/netgen/ngchecks",
    "authors": [
        {
            "name": "Netgen",
            "homepage": "https://netgen.io"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-phar": "*",
        "ext-zlib": "*",
        "composer-plugin-api": "^2.2"
    },
    "require-dev": {
        "composer/composer": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Netgen\\Ngchecks\\Composer\\": "composer/src/"
        }
    },
    "bin": [
        "composer/bin/ngchecks"
    ],
    "extra": {
        "class": "Netgen\\Ngchecks\\Composer\\Plugin"
    }
}
